# ── Servidor ──
# Porta HTTP do servidor Node
PORT=3004
# development | production
NODE_ENV=production
# Segredo para assinar os tokens de login (mínimo 32 caracteres, aleatório) — obrigatório
JWT_SECRET=
# URL pública do site (usada em links de e-mail, convites e CORS)
SITE_URL=http://localhost:5173
# Nome da plataforma usado nos e-mails (no front-end use VITE_APP_NAME, abaixo)
APP_NAME=Minha Plataforma

# ── Admin inicial (npm run seed) ──
# Se ADMIN_EMAIL/ADMIN_PASSWORD estiverem vazios, nenhum admin é criado
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# ── Uploads ──
# Tamanho máximo de arquivo enviado, em MB
MAX_FILE_SIZE_MB=500
# Pasta dos materiais complementares
UPLOAD_DIR=./uploads/materials

# ── E-mail (recuperação de senha, via SMTP) ──
# Servidor SMTP
SMTP_HOST=
SMTP_PORT=587
# Usuário e senha do SMTP
SMTP_USER=
SMTP_PASS=
# Remetente exibido (ex.: Minha Plataforma <contato@exemplo.com>)
SMTP_FROM=

# ── Notificações push (opcional) ──
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do emissor (mailto: ou URL)
VAPID_SUBJECT=mailto:admin@example.com

# ── Programa de indicação (opcional) ──
# Valor do produto usado para calcular a comissão de 10%
REFERRAL_PRODUCT_PRICE=1000
# Aviso de nova indicação no Telegram (bot token e chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Vídeos privados no Cloudflare R2 (opcional) ──
# ID da conta Cloudflare
R2_ACCOUNT_ID=
# Credenciais de API do R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nome do bucket privado com os vídeos
R2_BUCKET=
# Validade da URL assinada em segundos (padrão 21600 = 6h)
R2_URL_TTL_SECONDS=21600

# ── Front-end (variáveis lidas pelo Vite no build, em client/.env) ──
# Nome exibido na interface
VITE_APP_NAME=Minha Plataforma
# WhatsApp de suporte para o botão de upgrade (somente dígitos com DDI, ex.: 5511999999999)
VITE_SUPPORT_WHATSAPP=
